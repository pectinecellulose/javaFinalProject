# Configuration de la base de données MySQL
# Copiez ce fichier et renommez-le en .env (sans l'extension .txt)
# Ne partagez JAMAIS ce fichier avec vos identifiants réels !

# Configuration de la connexion
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bibliotheque
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_ici

# Configuration du driver MySQL
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

# Options de connexion (optionnel)
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_SERVER_TIMEZONE=UTC
